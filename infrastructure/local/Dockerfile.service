# Local runtime image; build the reactor jars with ./mvnw package first.
FROM eclipse-temurin:21-jre-jammy
ARG SERVICE
WORKDIR /app
COPY services/${SERVICE}/target/${SERVICE}-0.0.1-SNAPSHOT.jar app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-jar", "/app/app.jar"]
